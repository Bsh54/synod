# synod agents configuration

# HTTP port for the swarm API.
PORT=8211

# Optional web search provider. Without it, Legate falls back to the
# key-free Wikipedia search API.
# TAVILY_API_KEY=

# Optional LLM provider for future inference-backed synthesis.
# The Mozaik runtime reads these from the environment.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
